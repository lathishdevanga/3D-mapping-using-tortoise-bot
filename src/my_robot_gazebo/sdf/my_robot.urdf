    <joint name='camera_joint' type='fixed'>
      <parent>base_link</parent>
      <child>camera_link</child>
      <pose relative_to='base_link'>0.34999999999999998 0 0.050000000000000003 0 0 0</pose>
    </joint>
    <link name='camera_link'>
      <pose relative_to='camera_joint'>0 0 0 0 0 0</pose>
      <visual name='camera_link_visual'>
        <geometry>
          <box>
            <size>0.014999999999999999 0.13 0.022200000000000001</size>
          </box>
        </geometry>
      </visual>
      <collision name='camera_link_collision'>
        <geometry>
          <box>
            <size>0.014999999999999999 0.13 0.022200000000000001</size>
          </box>
        </geometry>
      </collision>
      <sensor name='depth_camera' type='rgbd'>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>10</update_rate>
        <topic>depth_camera</topic>
        <camera>
          <horizontal_fov>1.089</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
          </image>
          <clip>
            <near>0.050000000000000003</near>
            <far>2.5</far>
          </clip>
          <depth_camera>
            <output_type>color_point_cloud</output_type>
            <output>depths</output>
          </depth_camera>
        </camera>
        <gz_frame_id>camera_link</gz_frame_id>
        <baseline>0.2</baseline>
        <pointCloudCutoff>0.5</pointCloudCutoff>
        <pointCloudCutoffMax>3.0</pointCloudCutoffMax>
        <distortionK1>0</distortionK1>
        <distortionK2>0</distortionK2>
        <distortionK3>0</distortionK3>
        <distortionT1>0</distortionT1>
        <distortionT2>0</distortionT2>
        <CxPrime>0</CxPrime>
        <Cx>0</Cx>
        <Cy>0</Cy>
        <focalLength>0</focalLength>
        <hackBaseline>0</hackBaseline>
      </sensor>
    </link>
    <joint name='laser_joint' type='fixed'>
      <pose relative_to='base_link'>0.10000000000000001 0 0.17499999999999999 0 0 0</pose>
      <parent>base_link</parent>
      <child>lidar_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-inf</lower>
          <upper>inf</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name='lidar_link'>
      <pose relative_to='laser_joint'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.10000000000000001</mass>
        <inertia>
          <ixx>7.5833000000000004e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>7.5833000000000004e-05</iyy>
          <iyz>0</iyz>
          <izz>0.000125</izz>
        </inertia>
